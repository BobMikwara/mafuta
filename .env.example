# Copy to .env and adjust. Never commit real values.

# Database. Local defaults from infra/docker-compose.yml. For Supabase use pooled URL for app and direct for migrations.
DATABASE_URL=postgresql://fueltrack:fueltrack@localhost:5432/fueltrack_dev?schema=public
DIRECT_URL=postgresql://fueltrack:fueltrack@localhost:5432/fueltrack_dev?schema=public
SHADOW_DATABASE_URL=postgresql://fueltrack:fueltrack@localhost:5433/fueltrack_shadow?schema=public

# Supabase example (uncomment for production):
# DATABASE_URL=postgresql://postgres.<ref>:<pwd>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<pwd>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Never point the app at db.<ref>.supabase.co: the direct host is IPv6-only on
# free plans and unreachable from Vercel/AWS Lambda, which surfaces as
# 500 {"error":"internal_error"} on every authenticated request. URL-encode the
# password if it contains reserved characters (@ -> %40, # -> %23, / -> %2F).

# Persistence switch: true = Prisma (Supabase/Postgres), false = in-memory (dev)
USE_PRISMA=false

# Apply prisma/migrations at startup, under a Postgres advisory lock, and write
# the same _prisma_migrations bookkeeping table the Prisma CLI uses. Set to true
# in Vercel so a fresh database creates its own tables instead of failing every
# request with P2021 "table does not exist". Uses DIRECT_URL when it is set.
FUELTRACK_AUTO_MIGRATE=false
# Optional override for where prisma/migrations lives inside the deployed bundle.
FUELTRACK_MIGRATIONS_DIR=

# Network
HOST=0.0.0.0
PORT=3000

# Logging: debug, info, warn, error, critical
FUELTRACK_LOG_LEVEL=info
FUELTRACK_REQUEST_LOGGING=true

# Demo data. Requires FUELTRACK_DEV_API_KEY to be set to a value you supply.
# The key is hashed before storage and is never written to the logs.
FUELTRACK_SEED_DEMO=false
FUELTRACK_DEV_API_KEY=
FUELTRACK_DEMO_TENANT_ID=demo-tenant

# Optional override for the dashboard asset directory.
FUELTRACK_DASHBOARD_DIR=

# Frontend (apps/web)
VITE_API_URL=
# VITE_API_URL=http://localhost:3000 for local dev, or https://your-api.vercel.app for prod
